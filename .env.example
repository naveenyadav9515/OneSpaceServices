# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/onespace-dev-db

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=30d
TOKEN_ENCRYPTION_KEY=replace_with_a_32_plus_character_secret

# Google integrations
GOOGLE_CLIENT_ID=778605648466-7k1na0aeuqid19p96b9h10nc5ctjf5lf.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
PUBSUB_VERIFICATION_TOKEN=
GCP_PROJECT_ID=onespace26
GCP_PUBSUB_TOPIC=gmail-expenses-topic

# Gmail sync
# How far back a full sweep looks. This is the feature's retention guarantee:
# a bank email older than this that was never seen is never picked up.
GMAIL_SYNC_LOOKBACK_DAYS=7
# How far behind the last clean sync the incremental (push-driven) query starts.
# Absorbs mail whose delivery lagged its Gmail receive time. Costs nothing —
# re-listed messages are dropped by the ledger before any download.
GMAIL_SYNC_OVERLAP_MINUTES=120
# Gap between reconciliation sweeps, and therefore the worst-case delay for a
# transaction whose push never arrived.
GMAIL_SWEEP_INTERVAL_MINUTES=120
# Worker tuning. Concurrency bounds simultaneous mailbox syncs in this process.
GMAIL_WORKER_POLL_MS=3000
GMAIL_WORKER_CONCURRENCY=3
GMAIL_MAX_FETCHES_PER_RUN=150
# Quota units per second per user. Gmail's ceiling is 250; 100 leaves headroom.
GMAIL_QUOTA_UNITS_PER_SECOND=100

# ⚠️ Local development pointed at the production database MUST set both of these.
# Without them a laptop leases production sync jobs and re-registers production
# watches against whatever Pub/Sub topic it happens to be configured with.
# DISABLE_GMAIL_SYNC_WORKER=true
# DISABLE_GMAIL_WATCH_RENEWAL=true

# Security / CORS
ALLOWED_ORIGINS=http://localhost:4200,https://st-onespace.onrender.com,https://one-space.onrender.com
FRONTEND_URL=https://one-space.onrender.com
# Expense tracker
EXPENSE_MONTHLY_BUDGET=30000
